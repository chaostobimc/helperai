# Telegram-Bot-Token von @BotFather
TELEGRAM_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN

# DeepSeek Web-App LocalStorage userToken (nicht der Telegram-Token)
DEEPSEEK_AUTH_TOKEN=REPLACE_WITH_DEEPSEEK_USERTOKEN

# Telegram user ID, die als einzige Anfragen stellen darf
ALLOWED_USER_ID=8860332682

# Maximale Wartezeit pro DeepSeek-Anfrage in Sekunden
DEEPSEEK_TIMEOUT_SECONDS=180

# Relativ zum Projektordner oder als absoluter Pfad
SESSION_FILE=data/session.json

# Optional: DEBUG, INFO, WARNING oder ERROR
# LOG_LEVEL=INFO
